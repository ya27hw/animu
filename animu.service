[Unit]
Description=Animu - Anime Auto-Downloader Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/animu
ExecStart=/root/animu/venv/bin/python3 main.py --schedule
Restart=always
RestartSec=10

# Environment variables if needed
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
